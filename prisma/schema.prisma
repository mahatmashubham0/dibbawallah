// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminStatus {
  Active @map("active")

  @@map("admin_status")
}

model Admin {
  id           Int         @id @default(autoincrement())
  firstname    String
  lastname     String
  email        String      @unique
  profileImage String?     @map("profile_image")
  status       AdminStatus @default(Active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  meta         AdminMeta?

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

enum UserStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("user_status")
}

enum MealType {
  Breakfast @map("breakfast")
  Lunch     @map("lunch")
  Dinner    @map("dinner")

  @@map("meal_type")
}

enum AreaSource {
  Manual   @map("manual")
  Geoapify @map("geoapify")

  @@map("area_source")
}

model User {
  id           Int           @id @default(autoincrement())
  firstname    String
  lastname     String
  username     String?       @unique
  email        String        @unique
  dialCode     String?       @map("dial_code")
  mobile       String?       @unique
  profileImage String?       @map("profile_image")
  isVerified   Boolean       @default(false) @map("is_verified")
  country      String?
  status       UserStatus    @default(Active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  meta         UserMeta?
  settings     UserSetting[]

  @@map("user")
}

model Vendor {
  id            Int          @id @default(autoincrement())
  businessName  String       @map("business_name")
  dialCode      String       @default("+91") @map("dial_code")
  mobile        String       @unique
  inviteCode    String       @unique @map("invite_code")
  status        VendorStatus @default(Active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  meta              VendorMeta?
  paymentProfile    VendorPaymentProfile?
  locations      Location[]
  subscriptions     VendorSubscription[]

  @@map("vendor")
}

model Location {
  id          Int      @id @default(autoincrement())

  vendorId    Int      @map("vendor_id")
  areaId      Int      @map("area_id")

  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  area        Area     @relation(fields: [areaId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vendorId, areaId])

  @@index([vendorId])
  @@index([areaId])

  @@map("location")
}


model Area {
  id              Int      @id @default(autoincrement())

  stateId         Int      @map("state_id")
  cityId          Int      @map("city_id")

  name            String
  normalizedName  String   @map("normalized_name")

  pincode         String?

  latitude        Decimal? @db.Decimal(10,7)
  longitude       Decimal? @db.Decimal(10,7)

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  state           State    @relation(fields: [stateId], references: [id])
  city            City     @relation(fields: [cityId], references: [id])

  locations       Location[]

  @@unique([cityId, normalizedName])

  @@index([cityId])
  @@index([pincode])
  @@index([name])

  @@map("area")
}



model City {
  id              Int      @id @default(autoincrement())

  stateId         Int      @map("state_id")

  name            String
  normalizedName  String   @map("normalized_name")

  latitude        Decimal? @db.Decimal(10,7)
  longitude       Decimal? @db.Decimal(10,7)

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  state           State    @relation(fields: [stateId], references: [id])

  areas           Area[]

  @@unique([stateId, normalizedName])

  @@index([stateId])
  @@index([name])

  @@map("city")
}


model State {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  normalizedName  String   @unique @map("normalized_name")
  code            String?  @unique

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cities          City[]
  areas           Area[]

  @@map("state")
}

model VendorMeta {
  id           Int          @id @default(autoincrement())
  googleId     String? @unique @map("google_id")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  vendorId      Int          @unique @map("vendor_id")
  vendor        Vendor       @relation(fields: [vendorId], references: [id])

  @@map("vendor_meta")
}


model VendorPaymentProfile {
  id                  Int @id @default(autoincrement())
  vendorId            Int @unique   @map("vendor_id")
  upiId               String?       @map("upi_id")
  qrCodeUrl           String?       @map("qr_code_url")
  accountHolderName   String?        @map("account_holder_name")
  accountNumber       String?      @map("account_number")
  ifscCode            String?      @map("ifsc_code")
  bankName            String?      @map("bank_name")
  isDefault           Boolean @default(true)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  vendor              Vendor @relation(fields: [vendorId], references: [id])

  @@map("vendor_payment_profile")
}

model UserMeta {
  googleId     String? @unique @map("google_id")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  user         User    @relation(fields: [userId], references: [id])
  userId       Int     @unique() @map("user_id")

  @@map("user_meta")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  User   @map("user")
  System @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int             @id @default(autoincrement())
  mappedTo         String          @map("mapped_to")
  text             String          @default("")
  description      String          @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean         @map("is_defined_options")
  subSettings      Setting[]       @relation("SubSettings")
  dependsOn        Setting?        @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?            @map("parent_id")
  options          SettingOption[]
  userSettings     UserSetting[]
  systemSettings   SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id        Int     @id @default(autoincrement())
  text      String  @default("")
  value     String
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model UserSetting {
  selection Json
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @map("user_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([userId, settingId])
  @@map("user_setting")
}

model SystemSetting {
  selection Json
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}


enum PaymentMethod {
  UPI           @map("upi")
  QRCode        @map("qr_code")
  BankTransfer  @map("bank_transfer")
  Cash          @map("cash")

  @@map("payment_method")
}

enum PaymentStatus {
  Pending   @map("pending")
  Verified  @map("verified")
  Rejected  @map("rejected")

  @@map("payment_status")
}

enum VendorStatus {
  Active    @map("active")
  Inactive  @map("inactive")
  Suspended @map("suspended")
  Blocked   @map("blocked")

  @@map("vendor_status")
}

enum SubscriptionStatus {
  Active    @map("active")
  Expired   @map("expired")
  Cancelled @map("cancelled")
  Pending   @map("pending")

  @@map("subscription_status")
}

enum PlanType {
  Free       @map("free")
  Basic      @map("basic")
  Premium    @map("premium")
  Enterprise @map("enterprise")

  @@map("plan_type")
}

enum LedgerPartyType {
  Customer @map("customer")
  Vendor   @map("vendor")
  Platform @map("platform")

  @@map("ledger_party_type")
}

enum LedgerTransactionType {
  Credit @map("credit")
  Debit  @map("debit")

  @@map("ledger_transaction_type")
}

enum LedgerReferenceType {
  CustomerPayment     @map("customer_payment")
  SubscriptionPayment @map("subscription_payment")
  Refund              @map("refund")
  Penalty             @map("penalty")
  ManualAdjustment    @map("manual_adjustment")

  @@map("ledger_reference_type")
}

enum TransactionStatus {
  Pending   @map("pending")
  Approved  @map("approved")
  Rejected  @map("rejected")
  Failed    @map("failed")
  Refunded  @map("refunded")

  @@map("transaction_status")
}

enum PaymentProfileType {
  UPI          @map("upi")
  QRCode       @map("qr_code")
  BankAccount  @map("bank_account")

  @@map("payment_profile_type")
}


model CustomerPayment {
  id                    Int @id @default(autoincrement())
  customerId            Int          @map("customer_id")
  vendorId              Int          @map("vendor_id")
  amount                Decimal @db.Decimal(12,2)
  paymentMonth          DateTime      @map("payment_month")
  paymentMethod         PaymentMethod @map("payment_method")
  transactionReference  String?       @map("transaction_reference")
  screenshotUrl         String?       @map("screenshot_url")
  status                PaymentStatus 
  paidAt                DateTime      @map("paid_at")
  verifiedAt            DateTime?     @map("verified_at")
  verifiedByVendorId    Int?          @map("verified_by_vendor_id")
  remark                String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([vendorId])
  @@index([paymentMonth])
  @@map("customer_payment")
}


model PlatformPlan {
  id               Int @id @default(autoincrement())
  name             String
  amount           Decimal @db.Decimal(10,2)
  durationDays     Int          @map("duration_days")
  maxCustomers     Int?         @map("max_customers")
  features         Json?         @map("features")
  isActive         Boolean @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  subscriptions    VendorSubscription[]

  @@map("platform_plan")
}

model VendorSubscription {
  id                Int @id @default(autoincrement())
  vendorId          Int         @map("vendor_id")
  planId            Int         @map("plan_id")
  startDate         DateTime    @map("start_date")
  endDate           DateTime    @map("end_date")
  status            SubscriptionStatus
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  vendor            Vendor @relation(fields: [vendorId], references: [id])
  plan              PlatformPlan @relation(fields: [planId], references: [id])

  @@map("vendor_subscription")
}


model VendorSubscriptionPayment {
  id                    Int @id @default(autoincrement())
  vendorId              Int        @map("vendor_id")
  subscriptionId        Int         @map("subscription_id")
  amount                Decimal @db.Decimal(12,2)
  paymentMethod         PaymentMethod @map("payment_method")
  transactionReference  String?      @map("transaction_reference")
  screenshotUrl         String?      @map("screenshot_url")
  status                PaymentStatus  
  paidAt                DateTime    @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([vendorId])
  @@map("vendor_subscription_payment")
}


model Ledger {
  id                  BigInt @id @default(autoincrement())
  transactionNumber   String @unique    @map("transaction_number")
  sourceType          LedgerPartyType   @map("source_type")
  sourceId            Int               @map("source_id")
  destinationType     LedgerPartyType   @map("destination_type")
  destinationId       Int               @map("destination_id")
  amount              Decimal @db.Decimal(15,2)
  transactionType     LedgerTransactionType @map("transaction_type")
  referenceType       LedgerReferenceType   @map("reference_type")
  referenceId         Int                 @map("reference_id")
  narration           String?              @map("narration")
  meta                Json?               @map("meta")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@map("ledger")
}
