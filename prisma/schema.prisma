// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminStatus {
  Active @map("active")

  @@map("admin_status")
}

model Admin {
  id           Int         @id @default(autoincrement())
  firstname    String
  lastname     String
  email        String      @unique
  profileImage String?     @map("profile_image")
  status       AdminStatus @default(Active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  meta         AdminMeta?

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

enum UserStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("user_status")
}

enum MealType {
  Breakfast   @map("breakfast")
  Lunch       @map("lunch")
  Dinner      @map("dinner")
  Custom      @map("custom")
  CustomLunch @map("custom_lunch")

  @@map("meal_type")
}

enum AreaSource {
  Manual   @map("manual")
  Geoapify @map("geoapify")

  @@map("area_source")
}

model User {
  id                  Int                   @id @default(autoincrement())
  firstname           String
  lastname            String
  username            String?               @unique
  email               String                @unique
  dialCode            String?               @map("dial_code")
  mobile              String?               @unique
  profileImage        String?               @map("profile_image")
  isVerified          Boolean               @default(false) @map("is_verified")
  country             String?
  status              UserStatus            @default(Active)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  meta                UserMeta?
  customer            Customer?
  settings            UserSetting[]
  SubscriptionRequest SubscriptionRequest[]

  @@map("user")
}

model UserMeta {
  googleId     String? @unique @map("google_id")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  user         User    @relation(fields: [userId], references: [id])
  userId       Int     @unique() @map("user_id")

  @@map("user_meta")
}

model Vendor {
  id                   Int                         @id @default(autoincrement())
  fullName             String                      @map("full_name")
  businessName         String                      @map("business_name")
  dialCode             String                      @default("+91") @map("dial_code")
  mobile               String                      @unique
  status               VendorStatus                @default(Active)
  acceptingRequests    Boolean                     @default(true) @map("accepting_requests")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  meta                 VendorMeta?
  paymentProfile       VendorPaymentProfile?
  serviceAreas         VendorServiceArea[]
  vendorSubscription   VendorSubscription[]
  subscriptionPayment  VendorSubscriptionPayment[]
  meals                Meal[]
  mealPlans            MealPlan[]
  dailyMenus           DailyMenu[]
  customers            VendorCustomer[]
  subscriptions        Subscription[]
  subscriptionRequests PaymentRequest[]
  SubscriptionRequest  SubscriptionRequest[]

  @@map("vendor")
}

model VendorMeta {
  id           Int     @id @default(autoincrement())
  googleId     String? @unique @map("google_id")
  inviteCode   String  @unique @map("invite_code")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  vendorId     Int     @unique @map("vendor_id")
  vendor       Vendor  @relation(fields: [vendorId], references: [id])

  @@map("vendor_meta")
}

enum LocationOwnerType {
  Customer  @map("customer")
  Vendor    @map("vendor")

  @@map("location_owner_type")
}

model Location {
  id        Int               @id @default(autoincrement())
  ownerId   Int               @map("owner_id")
  ownerType LocationOwnerType @map("owner_type")
  areaId    Int               @map("area_id")
  area      Area              @relation(fields: [areaId], references: [id])
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([ownerId, ownerType])
  @@map("locations")
}

model VendorServiceArea {
  id        Int      @id @default(autoincrement())
  vendorId  Int      @map("vendor_id")
  areaId    Int      @map("area_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  area      Area     @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([vendorId, areaId])
  @@map("vendor_service_area")
}

model Area {
  id             Int      @id @default(autoincrement())
  stateId        Int      @map("state_id")
  cityId         Int      @map("city_id")
  name           String
  normalizedName String   @map("normalized_name")
  pincode        String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  state          State    @relation(fields: [stateId], references: [id])
  city           City     @relation(fields: [cityId], references: [id])

  locations         Location[]
  VendorServiceArea VendorServiceArea[]

  @@unique([cityId, normalizedName])
  @@index([cityId])
  @@index([pincode])
  @@index([name])
  @@map("area")
}

model City {
  id             Int       @id @default(autoincrement())
  stateId        Int       @map("state_id")
  name           String
  normalizedName String    @map("normalized_name")
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  areaSyncedAt   DateTime? @map("area_synced_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  state          State     @relation(fields: [stateId], references: [id])
  areas          Area[]

  @@unique([stateId, normalizedName])
  @@index([stateId])
  @@index([name])
  @@map("city")
}

model State {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  normalizedName String   @unique @map("normalized_name")
  code           String?  @unique
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  cities         City[]
  areas          Area[]

  @@map("state")
}

model VendorPaymentProfile {
  id                Int      @id @default(autoincrement())
  vendorId          Int      @unique @map("vendor_id")
  upiId             String?  @map("upi_id")
  qrCodeUrl         String?  @map("qr_code_url")
  accountHolderName String?  @map("account_holder_name")
  accountNumber     String?  @map("account_number")
  ifscCode          String?  @map("ifsc_code")
  bankName          String?  @map("bank_name")
  isDefault         Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  vendor            Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_payment_profile")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  User   @map("user")
  System @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int             @id @default(autoincrement())
  mappedTo         String          @map("mapped_to")
  text             String          @default("")
  description      String          @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean         @map("is_defined_options")
  subSettings      Setting[]       @relation("SubSettings")
  dependsOn        Setting?        @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?            @map("parent_id")
  options          SettingOption[]
  userSettings     UserSetting[]
  systemSettings   SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id        Int     @id @default(autoincrement())
  text      String  @default("")
  value     String
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model UserSetting {
  selection Json
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @map("user_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([userId, settingId])
  @@map("user_setting")
}

model SystemSetting {
  selection Json
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}

enum PaymentMethod {
  UPI          @map("upi")
  QRCode       @map("qr_code")
  BankTransfer @map("bank_transfer")
  Cash         @map("cash")

  @@map("payment_method")
}

enum PaymentStatus {
  Pending  @map("pending")
  Verified @map("verified")
  Rejected @map("rejected")

  @@map("payment_status")
}

enum VendorStatus {
  Active    @map("active")
  Inactive  @map("inactive")
  Suspended @map("suspended")
  Blocked   @map("blocked")

  @@map("vendor_status")
}

enum SubscriptionStatus {
  Active    @map("active")
  Expired   @map("expired")
  Cancelled @map("cancelled")
  Pending   @map("pending")
  Paused    @map("paused")

  @@map("subscription_status")
}

enum PlanType {
  Free       @map("free")
  Basic      @map("basic")
  Premium    @map("premium")
  Enterprise @map("enterprise")

  @@map("plan_type")
}

enum LedgerPartyType {
  Customer @map("customer")
  Vendor   @map("vendor")
  Platform @map("platform")

  @@map("ledger_party_type")
}

enum LedgerTransactionType {
  Credit @map("credit")
  Debit  @map("debit")

  @@map("ledger_transaction_type")
}

enum LedgerReferenceType {
  CustomerPayment     @map("customer_payment")
  SubscriptionPayment @map("subscription_payment")
  Refund              @map("refund")
  Penalty             @map("penalty")
  ManualAdjustment    @map("manual_adjustment")

  @@map("ledger_reference_type")
}

enum TransactionStatus {
  Pending  @map("pending")
  Approved @map("approved")
  Rejected @map("rejected")
  Failed   @map("failed")
  Refunded @map("refunded")

  @@map("transaction_status")
}

enum PaymentProfileType {
  UPI         @map("upi")
  QRCode      @map("qr_code")
  BankAccount @map("bank_account")

  @@map("payment_profile_type")
}

enum CustomerStatus {
  Offline    @map("offline")
  Registered @map("registered")
  UnRegistered @map("unregistered")
  Blocked    @map("blocked")
  @@map("customer_status")
}

model Customer {
  id           Int            @id @default(autoincrement())
  mobileNumber String
  fullName     String
  status       CustomerStatus @default(Offline)
  userId       Int?           @unique
  user         User?          @relation(fields: [userId], references: [id])
  notes        String?
  address      String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  vendorLinks VendorCustomer[]

  @@index([mobileNumber])
}

enum VendorCustomerStatus {
  Active   @map("active")
  Inactive @map("inactive")
  Blocked  @map("blocked")

  @@map("vendor_customer_status")
}

model VendorCustomer {
  id              Int                  @id @default(autoincrement())
  vendorId        Int
  customerId      Int
  vendor          Vendor               @relation(fields: [vendorId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  status          VendorCustomerStatus @default(Active)
  isActive        Boolean              @default(true)
  joinedAt        DateTime             @default(now())
  leftAt          DateTime?
  notes           String?
  subscriptions   Subscription[]
  paymentRequests PaymentRequest[]
  wallet          Wallet?
  refundRequests  RefundRequest[]

  @@unique([vendorId, customerId])
}

model Ledger {
  id                BigInt                @id @default(autoincrement())
  transactionNumber String                @unique @map("transaction_number")
  sourceType        LedgerPartyType       @map("source_type")
  sourceId          Int                   @map("source_id")
  destinationType   LedgerPartyType       @map("destination_type")
  destinationId     Int                   @map("destination_id")
  amount            Decimal               @db.Decimal(15, 2)
  transactionType   LedgerTransactionType @map("transaction_type")
  referenceType     LedgerReferenceType   @map("reference_type")
  referenceId       Int                   @map("reference_id")
  narration         String?               @map("narration")
  meta              Json?                 @map("meta")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@map("ledger")
}

enum PlanStatus {
  Active   @map("active")
  Inactive @map("inactive")

  @@map("plan_status")
}

enum PlatformPlanStatus {
  Active   @map("active")
  Inactive @map("inactive")

  @@map("platform_plan_status")
}

model PlatformPlan {
  id            Int                  @id @default(autoincrement())
  name          String
  description   String?
  monthlyPrice  Decimal              @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice   Decimal?             @map("yearly_price") @db.Decimal(10, 2)
  status        PlatformPlanStatus   @default(Active)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  subscriptions VendorSubscription[]

  @@map("platform_plan")
}

model VendorSubscription {
  id             Int                         @id @default(autoincrement())
  startDate      DateTime                    @map("start_date")
  endDate        DateTime                    @map("end_date")
  status         SubscriptionStatus          @default(Pending)
  autoRenew      Boolean                     @default(true) @map("auto_renew")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  vendorId       Int                         @map("vendor_id")
  vendor         Vendor                      @relation(fields: [vendorId], references: [id])
  platformPlanId Int                         @map("platform_plan_id")
  platformPlan   PlatformPlan                @relation(fields: [platformPlanId], references: [id])
  payments       VendorSubscriptionPayment[]

  @@index([vendorId])
  @@index([platformPlanId])
  @@map("vendor_subscription")
}

model VendorSubscriptionPayment {
  id                   Int                @id @default(autoincrement())
  amount               Decimal            @db.Decimal(12, 2)
  paymentMethod        PaymentMethod      @map("payment_method")
  transactionReference String?            @map("transaction_reference")
  screenshotUrl        String?            @map("screenshot_url")
  status               PaymentStatus
  paidAt               DateTime           @map("paid_at")
  vendorId             Int                @map("vendor_id")
  vendor               Vendor             @relation(fields: [vendorId], references: [id])
  subscriptionId       Int                @map("subscription_id")
  subscription         VendorSubscription @relation(fields: [subscriptionId], references: [id])
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([vendorId])
  @@map("vendor_subscription_payment")
}

model DailyMenu {
  id          Int             @id @default(autoincrement())
  vendorId    Int             @map("vendor_id")
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  mealType    MealType        @map("meal_type")
  menuDate    DateTime        @map("menu_date") @db.Date
  specialNote String?         @map("special_note") @db.Text
  isNotified  Boolean         @default(false) @map("is_notified")
  dishes      DailyMenuDish[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([vendorId, mealType, menuDate])
  @@index([menuDate])
  @@index([isNotified])
  @@map("daily_menu")
}

model DailyMenuDish {
  id           Int       @id @default(autoincrement())
  dailyMenuId  Int       @map("daily_menu_id")
  dailyMenu    DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  dishName     String    @map("dish_name")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([dailyMenuId])
  @@map("daily_menu_dish")
}

model Meal {
  id Int @id @default(autoincrement())

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mealMeta  MealMeta?
  planMeals MealPlanMeal[]
  items     MealItem[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@map("meal")
}


model MealMeta {
  id             Int @id @default(autoincrement())
  mealId         Int @unique
  meal           Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  deliveryTime   String
  cancellationCutoffMinutes Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("meal_meta")
}

model MealItem {
  id Int @id     @default(autoincrement())

  mealId Int     @map("meal_id")
  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name String
  isOptional     Boolean @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([mealId])
  @@map("meal_item")
}

model MealPlan {
  id Int @id @default(autoincrement())

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  name String

  description String?

  isActive Boolean @default(true)

  currentVersionId Int? @unique @map("current_version_id")

  currentVersion MealPlanVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Cascade)
  versions       MealPlanVersion[] @relation("PlanVersions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([vendorId, name])
  @@map("meal_plan")
}

model MealPlanVersion {
  id Int @id @default(autoincrement())

  planId Int @map("plan_id")

  plan           MealPlan  @relation("PlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  currentForPlan MealPlan? @relation("CurrentVersion")

  versionNumber Int

  effectiveFrom DateTime @default(now())

  totalTiffins Int  @map("total_tifins")

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meals MealPlanMeal[]

  prices MealPlanPrice[]

  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
  paymentRequests      PaymentRequest[]

  @@unique([planId, versionNumber])
  @@map("meal_plan_version")
}

model MealPlanMeal {
  id Int @id @default(autoincrement())

  versionId Int @map("version_id")

  mealId Int @map("meal_id")

  version MealPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  meal    Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([versionId, mealId])
  @@map("meal_plan_meal")
}

model MealPlanPrice {
  id Int @id @default(autoincrement())
  versionId Int @map("version_id")
  version MealPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  priceType  PriceType  @map("price_type") 
  amount Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([versionId, priceType])
  @@map("meal_plan_price")
}

enum PriceType {
  Daily   @map("daily")
  DemoTifinPrice   @map("demo_tifin_price")
  SundayDemoTifinPrice   @map("sunday_demo_tifin_price")
  Weekly  @map("weekly")
  Monthly @map("monthly")

  @@map("price_type")
}

enum PaymentRequestType {
  NewSubscription @map("new_subscription")
  Renewal         @map("renewal")
  PlanUpgrade     @map("plan_upgrade")
  PlanChange      @map("plan_change")

  @@map("payment_request_type")
}

model PaymentRequest {
  id                   Int                @id @default(autoincrement())
  vendorCustomerId     Int                @map("vendor_customer_id")
  vendorCustomer       VendorCustomer     @relation(fields: [vendorCustomerId], references: [id])
  vendorId             Int                @map("vendor_id")
  vendor               Vendor             @relation(fields: [vendorId], references: [id])
  planVersionId        Int                @map("plan_version_id")
  planVersion          MealPlanVersion    @relation(fields: [planVersionId], references: [id])
  requestType          PaymentRequestType @map("request_type")
  amount               Decimal            @db.Decimal(10, 2)
  paymentMethod        PaymentMethod      @map("payment_method")
  transactionReference String?            @map("transaction_reference")
  paymentProofUrl      String?            @map("payment_proof_url")
  status               PaymentStatus      @default(Pending)
  rejectionReason      String?            @map("rejection_reason")
  reviewedBy           Int?               @map("reviewed_by")
  reviewedAt           DateTime?          @map("reviewed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  subscription         Subscription?

  @@index([vendorCustomerId])
  @@index([vendorId])
  @@index([status])
  @@index([requestType])
  @@map("payment_request")
}

model Subscription {
  id               Int                @id @default(autoincrement())
  vendorId         Int                @map("vendor_id")
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  paymentRequestId Int                @unique @map("payment_request_id")
  paymentRequest   PaymentRequest     @relation(fields: [paymentRequestId], references: [id])
  planVersionId    Int                @map("plan_version_id")
  planVersion      MealPlanVersion    @relation(fields: [planVersionId], references: [id])
  vendorCustomerId Int                @map("vendor_customer_id")
  vendorCustomer   VendorCustomer     @relation(fields: [vendorCustomerId], references: [id])
  status           SubscriptionStatus @default(Active)
  startDate        DateTime           @map("start_date")
  endDate          DateTime?          @map("end_date")
  pauseStartDate   DateTime?          @map("pause_start_date")
  pauseEndDate     DateTime?          @map("pause_end_date")
  amountPaid       Decimal            @db.Decimal(10, 2)
  mealsConsumed    Int                @default(0) @map("meals_consumed")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  pauseRequests    PauseRequest[]
  deliveries       MealDelivery[]
  refundRequests   RefundRequest[]

  @@index([vendorId])
  @@index([status])
  @@index([planVersionId])
  @@map("subscription")
}

enum SubscriptionRequestStatus {
  Pending  @map("pending")
  Accepted @map("accepted")
  Declined @map("declined")

  @@map("subscription_request_status")
}

model SubscriptionRequest {
  id                Int                       @id @default(autoincrement())
  userId            Int                       @map("user_id")
  user              User                      @relation(fields: [userId], references: [id])
  vendorId          Int                       @map("vendor_id")
  vendor            Vendor                    @relation(fields: [vendorId], references: [id])
  planVersionId     Int                       @map("plan_version_id")
  planVersion       MealPlanVersion           @relation(fields: [planVersionId], references: [id])
  status            SubscriptionRequestStatus @default(Pending)
  paymentProofUrl   String                    @map("payment_proof_url")
  declineReason     String?                   @map("decline_reason")
  vendorRespondedAt DateTime?                 @map("vendor_responded_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@map("subscription_request")
}

model Wallet {
  id                      Int                 @id @default(autoincrement())
  vendorCustomerId        Int                 @unique @map("vendor_customer_id")
  vendorCustomer          VendorCustomer      @relation(fields: [vendorCustomerId], references: [id], onDelete: Cascade)
  usedCredits             Int                 @default(0) @map("used_credits")
  totalCredits            Int                 @default(0) @map("total_credits")
  lowCreditThreshold      Int                 @default(5) @map("low_credit_threshold")
  criticalCreditThreshold Int                 @default(2) @map("critical_credit_threshold")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  transactions            WalletTransaction[]

  @@map("wallet")
}

enum WalletTransactionType {
  Recharge              @map("recharge")
  Consumption           @map("consumption")
  Refund                @map("refund")
  CarryForward          @map("carry_forward")
  OutstandingAdjustment @map("outstanding_adjustment")
  ManualAdjustment      @map("manual_adjustment")
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  walletId    Int                   @map("wallet_id")
  wallet      Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Int
  type        WalletTransactionType
  description String?
  referenceId String?               @map("reference_id")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("wallet_transaction")
}

enum RefundStatus {
  Pending   @map("pending")
  Approved  @map("approved")
  Rejected  @map("rejected")
  Processed @map("processed")
}

model RefundRequest {
  id               Int            @id @default(autoincrement())
  vendorCustomerId Int            @map("vendor_customer_id")
  vendorCustomer   VendorCustomer @relation(fields: [vendorCustomerId], references: [id])
  subscriptionId   Int?           @map("subscription_id")
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])
  credits          Int
  amount           Decimal        @db.Decimal(10, 2)
  status           RefundStatus   @default(Pending)
  reason           String?
  cancellationFee  Decimal        @default(0) @map("cancellation_fee") @db.Decimal(10, 2)
  processingFee    Decimal        @default(0) @map("processing_fee") @db.Decimal(10, 2)
  taxDeduction     Decimal        @default(0) @map("tax_deduction") @db.Decimal(10, 2)
  rejectionReason  String?        @map("rejection_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("refund_request")
}

enum PauseRequestStatus {
  Pending   @map("pending")
  Approved  @map("approved")
  Rejected  @map("rejected")
  Completed @map("completed")
  Cancelled @map("cancelled")
}

model PauseRequest {
  id             Int                @id @default(autoincrement())
  subscriptionId Int                @map("subscription_id")
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id])
  startDate      DateTime           @map("start_date")
  endDate        DateTime           @map("end_date")
  status         PauseRequestStatus @default(Pending)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("pause_request")
}

enum DeliveryStatus {
  Pending   @map("pending")
  Delivered @map("delivered")
  Missed    @map("missed")
  Cancelled @map("cancelled")
}

model MealDelivery {
  id             Int            @id @default(autoincrement())
  subscriptionId Int            @map("subscription_id")
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  deliveryDate   DateTime       @map("delivery_date") @db.Date
  status         DeliveryStatus @default(Pending)
  deliveryTime   String?        @map("delivery_time")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("meal_delivery")
}

model NotificationToken {
  id        Int            @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique
  deviceId  String?  @map("device_id")
  platform  String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("notification_token")
}

model NotificationTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  body      String
  variables Json?

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  @@map("notification_template")  
}


model NotificationEvent {
  id        Int      @id @default(autoincrement())
  type      String   // ORDER_CREATED, TASK_DONE
  entityId  String?  @map("entity_id") // orderId, taskId
  actorId   String?  @map("actor_id") // who triggered it
  payload   Json?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  processed Boolean @default(false)

  @@index([type])
  @@map("notification_event")
}